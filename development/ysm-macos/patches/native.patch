 }
 
+enum class GeoModelMessage : uint8_t {
+    kGeoModel,
+    kBone,
+    kGeoProperties,
+    kCubes,
+    kCubeLegacy,
+};
+
+bool ReadWireVarint(std::span<const uint8_t> data, size_t& offset,
+                    uint64_t& value) noexcept {
+    value = 0;
+    for (uint32_t index = 0; index < 10; ++index) {
+        if (offset >= data.size()) {
+            return false;
+        }
+        const auto byte = data[offset++];
+        if (index == 9 && byte > 1) {
+            return false;
+        }
+        value |= static_cast<uint64_t>(byte & 0x7f) << (index * 7);
+        if ((byte & 0x80) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool SkipWireField(std::span<const uint8_t> data, size_t& offset,
+                   uint32_t field_number, uint8_t wire_type,
+                   uint32_t group_depth = 0) noexcept {
+    switch (wire_type) {
+        case 0: {
+            uint64_t ignored = 0;
+            return ReadWireVarint(data, offset, ignored);
+        }
+        case 1:
+            if (data.size() - offset < 8) {
+                return false;
+            }
+            offset += 8;
+            return true;
+        case 2: {
+            uint64_t length = 0;
+            if (!ReadWireVarint(data, offset, length) ||
+                length > data.size() - offset) {
+                return false;
+            }
+            offset += static_cast<size_t>(length);
+            return true;
+        }
+        case 3: {
+            if (group_depth >= 64) {
+                return false;
+            }
+            while (offset < data.size()) {
+                uint64_t key = 0;
+                if (!ReadWireVarint(data, offset, key)) {
+                    return false;
+                }
+                const auto nested_field = static_cast<uint32_t>(key >> 3);
+                const auto nested_wire = static_cast<uint8_t>(key & 7);
+                if (key > ((uint64_t{0x1fffffff} << 3) | 7) ||
+                    nested_field == 0 || nested_field > 0x1fffffff ||
+                    nested_wire > 5) {
+                    return false;
+                }
+                if (nested_wire == 4) {
+                    return nested_field == field_number;
+                }
+                if (!SkipWireField(data, offset, nested_field, nested_wire,
+                                   group_depth + 1)) {
+                    return false;
+                }
+            }
+            return false;
+        }
+        case 4:
+            return false;
+        case 5:
+            if (data.size() - offset < 4) {
+                return false;
+            }
+            offset += 4;
+            return true;
+        default:
+            return false;
+    }
+}
+
+bool ValidateGeoModelMessage(std::span<const uint8_t> data,
+                             GeoModelMessage message,
+                             uint32_t depth = 0) noexcept {
+    if (depth > 8) {
+        return false;
+    }
+    size_t offset = 0;
+    while (offset < data.size()) {
+        uint64_t key = 0;
+        if (!ReadWireVarint(data, offset, key)) {
+            return false;
+        }
+        const auto field_number = static_cast<uint32_t>(key >> 3);
+        const auto wire_type = static_cast<uint8_t>(key & 7);
+        if (key > ((uint64_t{0x1fffffff} << 3) | 7) || field_number == 0 ||
+            field_number > 0x1fffffff || wire_type > 5 ||
+            wire_type == 4) {
+            return false;
+        }
+
+        bool nested = false;
+        GeoModelMessage nested_message = GeoModelMessage::kGeoModel;
+        bool packed_float = false;
+        bool packed_varint = false;
+        bool unpacked_float = false;
+        bool scalar_uint32 = false;
+        bool scalar_bool = false;
+        switch (message) {
+            case GeoModelMessage::kGeoModel:
+                if (wire_type == 2 && field_number >= 1 && field_number <= 3) {
+                    nested = true;
+                    nested_message = field_number == 1
+                                         ? GeoModelMessage::kBone
+                                         : field_number == 2
+                                               ? GeoModelMessage::kGeoProperties
+                                               : GeoModelMessage::kCubes;
+                }
+                break;
+            case GeoModelMessage::kBone:
+                if ((field_number == 1 || field_number == 2) &&
+                    wire_type == 2) {
+                    // Strings are length-delimited but their contents are not
+                    // protobuf messages.
+                } else if ((field_number == 3 || field_number == 4) &&
+                           wire_type == 2) {
+                    packed_float = true;
+                } else if ((field_number == 3 || field_number == 4) &&
+                           wire_type == 5) {
+                    unpacked_float = true;
+                } else if (field_number == 5 && wire_type == 0) {
+                    scalar_bool = true;
+                } else if (field_number == 6 && wire_type == 0) {
+                    scalar_uint32 = true;
+                }
+                break;
+            case GeoModelMessage::kGeoProperties:
+                break;
+            case GeoModelMessage::kCubes:
+                if (field_number == 1 && wire_type == 2) {
+                    nested = true;
+                    nested_message = GeoModelMessage::kCubeLegacy;
+                }
+                break;
+            case GeoModelMessage::kCubeLegacy:
+                if ((field_number == 2 || field_number == 4 ||
+                     field_number == 6) &&
+                    wire_type == 2) {
+                    packed_float = true;
+                } else if ((field_number == 2 || field_number == 4 ||
+                            field_number == 6) &&
+                           wire_type == 5) {
+                    unpacked_float = true;
+                } else if ((field_number == 3 || field_number == 5) &&
+                           wire_type == 2) {
+                    packed_varint = true;
+                } else if ((field_number == 1 || field_number == 3 ||
+                            field_number == 5) &&
+                           wire_type == 0) {
+                    scalar_uint32 = true;
+                }
+                break;
+        }
+
+        if (nested || packed_float || packed_varint ||
+            (message == GeoModelMessage::kBone &&
+             ((field_number == 1 || field_number == 2) && wire_type == 2))) {
+            uint64_t length = 0;
+            if (!ReadWireVarint(data, offset, length) ||
+                length > data.size() - offset) {
+                return false;
+            }
+            const auto payload = data.subspan(offset, static_cast<size_t>(length));
+            if (nested &&
+                !ValidateGeoModelMessage(payload, nested_message, depth + 1)) {
+                return false;
+            }
+            if (packed_float && length % sizeof(uint32_t) != 0) {
+                return false;
+            }
+            if (packed_varint) {
+                size_t packed_offset = 0;
+                while (packed_offset < payload.size()) {
+                    uint64_t value = 0;
+                    if (!ReadWireVarint(payload, packed_offset, value) ||
+                        value > std::numeric_limits<uint32_t>::max()) {
+                        return false;
+                    }
+                }
+            }
+            offset += static_cast<size_t>(length);
+            continue;
+        }
+
+        if (unpacked_float) {
+            if (data.size() - offset < sizeof(uint32_t)) {
+                return false;
+            }
+            offset += sizeof(uint32_t);
+            continue;
+        }
+        if (scalar_uint32 || scalar_bool) {
+            uint64_t value = 0;
+            if (!ReadWireVarint(data, offset, value) ||
+                (scalar_uint32 &&
+                 value > std::numeric_limits<uint32_t>::max())) {
+                return false;
+            }
+            continue;
+        }
+        if (message == GeoModelMessage::kGeoProperties &&
+            field_number >= 1 && field_number <= 2 && wire_type == 5) {
+            if (data.size() - offset < sizeof(uint32_t)) {
+                return false;
+            }
+            offset += sizeof(uint32_t);
+            continue;
+        }
+        if (!SkipWireField(data, offset, field_number, wire_type)) {
+            return false;
+        }
+    }
+    return true;
+}
+
