+TEST(BakedModelTest, RejectsMalformedGeometryWireDataWithoutThrowing) {
+    InitCpuInfo();
+    const std::array<gfx::bake::Pixel, 1> pixels{
+        gfx::bake::Pixel{255, 255, 255, 255},
+    };
+    gfx::bake::Texture texture(pixels.data(), 1, 1);
+    const std::array malformed_models{
+        std::string("\xff", 1),
+        std::string("\x0a\x01\xff", 3),
+        std::string("\x1a\x05\x0a\x03\x1a\x01\x80", 7),
+    };
+
+    for (const auto& bytes : malformed_models) {
+        const auto baked = gfx::bake::BakeModel(StrBuf(bytes), texture, {});
+        ASSERT_FALSE(baked.ok());
+        EXPECT_EQ(baked.status().code(), absl::StatusCode::kInvalidArgument);
+        EXPECT_EQ(gfx::bake::TryBakeModel(StrBuf(bytes), texture, {}).code(),
+                  absl::StatusCode::kInvalidArgument);
+    }
+}
