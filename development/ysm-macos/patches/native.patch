+TEST(LegacyAnimationProtoTest, PreservesExplicitZeroLoopPresence) {
+    animation_proto::Animation source{};
+    source.length = 0.0F;
+    source.loop = animation_proto::LoopType::LOOP_TYPE_UNSPECIFIED;
+    std::string encoded;
+    struct_pb::to_pb(source, encoded);
+    EXPECT_EQ(std::string("\x18\x00", 2), encoded);
+    animation_proto::Animation parsed{};
+    ASSERT_NO_THROW(parsed.from_pb(encoded));
+    ASSERT_TRUE(parsed.loop.has_value());
+    EXPECT_EQ(*parsed.loop, animation_proto::LoopType::LOOP_TYPE_UNSPECIFIED);
+}
