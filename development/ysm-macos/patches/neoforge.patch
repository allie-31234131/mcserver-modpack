new file mode 100644
index 0000000..0033617
--- /dev/null
+++ b/src/builtinIndexTool/java/com/elfmcys/ysm/tool/OpusFixtureReferenceTool.java
@@ -0,0 +1,80 @@
+package com.elfmcys.ysm.tool;
+
+import com.elfmcys.ysm.format.media.SupportedAudioProbe;
+import com.elfmcys.ysm.natives.NativeRuntime;
+import com.elfmcys.ysm.natives.sound.OpusDecoder;
+
+import java.io.ByteArrayOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+
+/** Writes the Windows x64 PCM baseline used by the cross-platform Opus tests. */
+public final class OpusFixtureReferenceTool {
+    private static final List<String> FIXTURES = List.of(
+            "opus-origin", "opus-input-rate", "opus-under", "opus-long");
+    private static final String NATIVE_PATH_ENV = "YSM_NATIVE_PATH";
+
+    private OpusFixtureReferenceTool() {
+    }
+
+    public static void main(String[] args) throws Exception {
+        if (!System.getProperty("os.name", "").startsWith("Windows")
+                || !System.getProperty("os.arch", "").equalsIgnoreCase("amd64")) {
+            throw new IllegalStateException("Opus fixture references must be generated on Windows x64");
+        }
+        if (args.length != 1) {
+            throw new IllegalArgumentException("Expected the audio fixture directory argument");
+        }
+        var nativePath = System.getenv(NATIVE_PATH_ENV);
+        if (nativePath == null || nativePath.isBlank()) {
+            throw new IllegalStateException(NATIVE_PATH_ENV + " must identify the Windows x64 DLL");
+        }
+        System.load(Path.of(nativePath).toAbsolutePath().normalize().toString());
+        NativeRuntime.initialize(new NativeRuntime.JavaConfig(3));
+
+        var root = Path.of(args[0]).toAbsolutePath().normalize();
+        for (var name : FIXTURES) {
+            var encodedBytes = Files.readAllBytes(root.resolve(name + ".ogg"));
+            var encoded = ByteBuffer.allocateDirect(encodedBytes.length);
+            encoded.put(encodedBytes).flip();
+            var inspection = SupportedAudioProbe.inspect(encoded);
+            if (!inspection.playable()
+                    || inspection.media().encoding() != SupportedAudioProbe.Encoding.OGG_OPUS) {
+                throw new IllegalStateException(name + ".ogg is not a supported Opus stream: "
+                        + inspection.diagnostic());
+            }
+
+            var pcm = new ByteArrayOutputStream();
+            try (var decoder = new OpusDecoder(inspection.media().frames())) {
+                decoder.feed(encoded);
+                decoder.endInput();
+                var block = ByteBuffer.allocateDirect(16 * 1024);
+                while (true) {
+                    block.clear();
+                    int size = decoder.decode(block);
+                    if (size == 0) {
+                        break;
+                    }
+                    if (size < 0) {
+                        throw new IllegalStateException(name
+                                + ".ogg did not decode to completion: " + size);
+                    }
+                    block.position(0).limit(size);
+                    byte[] bytes = new byte[size];
+                    block.get(bytes);
+                    pcm.write(bytes);
+                }
+            }
+            long expectedBytes = Math.multiplyExact(inspection.media().frames(), 2L);
+            if (pcm.size() != expectedBytes) {
+                throw new IllegalStateException(name + " decoded " + pcm.size()
+                        + " bytes; expected " + expectedBytes);
+            }
+            Files.write(root.resolve(name + ".s16le"), pcm.toByteArray());
+            System.out.println("Wrote Windows x64 reference: " + name + " frames="
+                    + inspection.media().frames());
+        }
+    }
+}
