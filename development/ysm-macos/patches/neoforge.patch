+#!/usr/bin/env python3
+"""Regenerate the small synthetic Ogg fixtures used by the audio contract tests."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import shutil
+import struct
+import subprocess
+import tempfile
+import wave
+from pathlib import Path
+
+
+FIXTURES = (
+    ("opus-origin", "opus", 48_000, 60_001),
+    ("opus-under", "opus", 48_000, 191_999),
+    ("opus-long", "opus", 48_000, 240_000),
+    ("vorbis-under", "vorbis", 44_100, 176_399),
+    ("vorbis-exact", "vorbis", 44_100, 176_400),
+)
+
+
+def make_wave(path: Path, sample_rate: int, frames: int) -> None:
+    with wave.open(str(path), "wb") as output:
+        output.setnchannels(2)
+        output.setsampwidth(2)
+        output.setframerate(sample_rate)
+        data = bytearray()
+        for frame in range(frames):
+            sample = int(
+                2_200 * math.sin(2 * math.pi * 440 * frame / sample_rate)
+                + 800 * math.sin(2 * math.pi * 997 * frame / sample_rate)
+            )
+            sample = max(-32_768, min(32_767, sample))
+            data.extend(struct.pack("<hh", sample, sample))
+        output.writeframes(data)
+
+
+def run(command: list[str]) -> None:
+    subprocess.run(command, check=True)
+
+
+def encode(ffmpeg: str, work: Path, name: str, codec: str,
+           sample_rate: int, frames: int, destination: Path) -> None:
+    source = work / f"{name}.wav"
+    encoded = work / f"{name}.ogg"
+    stereo_reference = work / f"{name}.stereo.s16le"
+    reference = work / f"{name}.s16le"
+    make_wave(source, sample_rate, frames)
+
+    command = [ffmpeg, "-hide_banner", "-loglevel", "error", "-y",
+               "-fflags", "+bitexact", "-i", str(source), "-map_metadata", "-1"]
+    if codec == "opus":
+        command += ["-c:a", "libopus", "-application", "audio", "-b:a", "96k",
+                    "-frame_duration", "20", "-vbr", "off", "-compression_level", "10"]
+        output_rate = 48_000
+    else:
+        command += ["-c:a", "libvorbis", "-q:a", "5"]
+        output_rate = 44_100
+    run(command + ["-f", "ogg", str(encoded)])
+    run([ffmpeg, "-hide_banner", "-loglevel", "error", "-y", "-i", str(encoded),
+         "-map_metadata", "-1", "-ac", "2", "-ar", str(output_rate),
+         "-c:a", "pcm_s16le", "-f", "s16le", str(stereo_reference)])
+    stereo = stereo_reference.read_bytes()
+    if len(stereo) % 4:
+        raise ValueError(f"FFmpeg returned a partial stereo sample frame for {name}")
+    mono = bytearray()
+    for offset in range(0, len(stereo), 4):
+        left, right = struct.unpack_from("<hh", stereo, offset)
+        mono.extend(struct.pack("<h", round((left + right) / 2)))
+    reference.write_bytes(mono)
+    shutil.copyfile(encoded, destination / encoded.name)
+    shutil.copyfile(reference, destination / reference.name)
+    source.unlink()
+
+
+def ogg_crc(data: bytes) -> int:
+    table = []
+    for value in range(256):
+        remainder = value << 24
+        for _ in range(8):
+            remainder = ((remainder << 1) ^ 0x04C11DB7) & 0xFFFFFFFF \
+                if remainder & 0x80000000 else (remainder << 1) & 0xFFFFFFFF
+        table.append(remainder)
+    checksum = 0
+    for value in data:
+        checksum = ((checksum << 8) & 0xFFFFFFFF) \
+            ^ table[((checksum >> 24) & 0xFF) ^ value]
+    return checksum
+
+
+def set_opus_input_rate(path: Path, sample_rate: int) -> None:
+    data = bytearray(path.read_bytes())
+    header = data.find(b"OpusHead")
+    if header < 0:
+        raise ValueError(f"missing OpusHead in {path}")
+    struct.pack_into("<I", data, header + 12, sample_rate)
+    page = data.rfind(b"OggS", 0, header)
+    if page < 0:
+        raise ValueError(f"missing first Ogg page in {path}")
+    segment_count = data[page + 26]
+    page_end = page + 27 + segment_count + sum(data[page + 27:page + 27 + segment_count])
+    data[page + 22:page + 26] = b"\0\0\0\0"
+    struct.pack_into("<I", data, page + 22, ogg_crc(bytes(data[page:page_end])))
+    path.write_bytes(data)
+
+
+def inspect(path: Path) -> dict[str, int | str]:
+    data = path.read_bytes()
+    offset = 0
+    final_granule = -1
+    first_page_flags = 0
+    final_page_flags = 0
+    while offset < len(data):
+        if data[offset:offset + 4] != b"OggS" or offset + 27 > len(data):
+            raise ValueError(f"invalid Ogg page in {path}")
+        segments = data[offset + 26]
+        table_end = offset + 27 + segments
+        if table_end > len(data):
+            raise ValueError(f"truncated Ogg lacing table in {path}")
+        page_end = table_end + sum(data[offset + 27:table_end])
+        if page_end > len(data):
+            raise ValueError(f"truncated Ogg page in {path}")
+        if offset == 0:
+            first_page_flags = data[offset + 5]
+        final_page_flags = data[offset + 5]
+        final_granule = struct.unpack_from("<q", data, offset + 6)[0]
+        offset = page_end
+
+    if offset != len(data) or not first_page_flags & 2 or not final_page_flags & 4:
+        raise ValueError(f"invalid Ogg page sequence in {path}")
+    opus = data.find(b"OpusHead")
+    if opus >= 0:
+        codec = "opus"
+        channels = data[opus + 9]
+        pre_skip = struct.unpack_from("<H", data, opus + 10)[0]
+        input_rate = struct.unpack_from("<I", data, opus + 12)[0]
+        sample_rate = 48_000
+        frames = final_granule - pre_skip
+    else:
+        vorbis = data.find(b"\x01vorbis")
+        if vorbis < 0:
+            raise ValueError(f"unsupported codec in {path}")
+        codec = "vorbis"
+        channels = data[vorbis + 11]
+        pre_skip = 0
+        input_rate = sample_rate = struct.unpack_from("<I", data, vorbis + 12)[0]
+        frames = final_granule
+    return {"codec": codec, "channels": channels, "sample_rate": sample_rate,
+            "frames": frames, "pre_skip": pre_skip, "input_rate": input_rate}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ffmpeg", default=os.environ.get("FFMPEG_EXE") or shutil.which("ffmpeg"))
+    parser.add_argument("--output", type=Path,
+                        default=Path(__file__).resolve().parents[1]
+                        / "src/test/resources/audio-fixtures")
+    args = parser.parse_args()
+    if not args.ffmpeg:
+        raise SystemExit("ffmpeg was not found; pass --ffmpeg or set FFMPEG_EXE")
+
+    args.output.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix="ysm-audio-fixtures-") as temporary:
+        work = Path(temporary)
+        for name, codec, sample_rate, frames in FIXTURES:
+            encode(args.ffmpeg, work, name, codec, sample_rate, frames, args.output)
+
+    # Opus decodes at 48 kHz regardless of this informational source-rate field.
+    shutil.copyfile(args.output / "opus-origin.ogg", args.output / "opus-input-rate.ogg")
+    set_opus_input_rate(args.output / "opus-input-rate.ogg", 44_100)
+    shutil.copyfile(args.output / "opus-origin.s16le", args.output / "opus-input-rate.s16le")
+
+    cases = []
+    definitions = [
+        ("opus-origin", "opus", 48_000, 60_001, 312),
+        ("opus-input-rate", "opus", 48_000, 60_001, 312),
+        ("opus-under", "opus", 48_000, 191_999, 312),
+        ("opus-long", "opus", 48_000, 240_000, 312),
+        ("vorbis-under", "vorbis", 44_100, 176_399, 0),
+        ("vorbis-exact", "vorbis", 44_100, 176_400, 0),
+    ]
+    for name, codec, sample_rate, frames, pre_skip in definitions:
+        metadata = inspect(args.output / f"{name}.ogg")
+        expected = {"codec": codec, "channels": 2, "sample_rate": sample_rate,
+                    "frames": frames, "pre_skip": pre_skip}
+        actual = {key: metadata[key] for key in expected}
+        if actual != expected:
+            raise SystemExit(f"{name}.ogg metadata mismatch: expected {expected}, got {actual}")
+        reference = args.output / f"{name}.s16le"
+        if reference.stat().st_size != frames * 2:
+            raise SystemExit(f"{reference.name} has an unexpected PCM frame count")
+        cases.append({
+            "id": name,
+            "encoded": f"{name}.ogg",
+            "reference": f"{name}.s16le",
+            "codec": codec,
+            "source_channels": 2,
+            "sample_rate": sample_rate,
+            "frames": frames,
+            "pre_skip": pre_skip,
+            "short_eligible": frames < 4 * sample_rate,
+        })
+
+    (args.output / "manifest.json").write_text(
+        json.dumps({"format_version": 1, "cases": cases}, indent=2) + "\n",
+        encoding="utf-8")
+    print(f"Generated and verified {len(cases)} audio fixtures in {args.output}")
+
+
+if __name__ == "__main__":
+    main()
