+package com.elfmcys.ysm.util;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.file.Path;
+import java.nio.file.Files;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Callable;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class MacNativePlatformTest {
+    @TempDir
+    Path temporary;
+    @Test
+    void acceptsBothJvmArm64NamesAndRejectsIntel() {
+        assertTrue(MacNativePlatform.isArm64("aarch64"));
+        assertTrue(MacNativePlatform.isArm64("arm64"));
+        assertTrue(MacNativePlatform.isArm64("ARM64"));
+        assertFalse(MacNativePlatform.isArm64("x86_64"));
+        assertFalse(MacNativePlatform.isArm64("amd64"));
+        assertFalse(MacNativePlatform.isArm64(null));
+    }
+
+    @Test
+    void enforcesTheNativeDeploymentTarget() {
+        for (String version : new String[]{"14.5", "14.5.0", "14.6.1", "15.0", "26.6.2"}) {
+            assertTrue(MacNativePlatform.meetsMinimumVersion(version), version);
+        }
+        for (String version : new String[]{"13.7.1", "14", "14.4.9", "", "unknown"}) {
+            assertFalse(MacNativePlatform.meetsMinimumVersion(version), version);
+        }
+        assertFalse(MacNativePlatform.meetsMinimumVersion(null));
+    }
+
+    @Test
+    void preservesSpacesInTheUserLibraryPath() {
+        assertEquals(Path.of("/Users/Test User/Library/Application Support/ysm/native/macos-arm64"),
+                MacNativePlatform.libraryDirectory("/Users/Test User"));
+        assertEquals("3.0-dev-forge+mc1.20.1_unsafe_name",
+                MacNativePlatform.safeVersion("3.0-dev-forge+mc1.20.1/unsafe\\name"));
+    }
+
+    @Test
+    void changedLibrariesNeverOverwriteTheOldVersion() throws Exception {
+        byte[] oldBytes = {1, 2, 3}, newBytes = {4, 5, 6};
+        Path oldPath = MacNativePlatform.extractLibrary(temporary, "dev/snapshot", oldBytes);
+        Path newPath = MacNativePlatform.extractLibrary(temporary, "dev/snapshot", newBytes);
+        assertNotEquals(oldPath, newPath);
+        assertArrayEquals(oldBytes, Files.readAllBytes(oldPath));
+        assertArrayEquals(newBytes, Files.readAllBytes(newPath));
+    }
+
+    @Test
+    void concurrentExtractionPublishesOnlyCompleteBytesAndRepairsTruncation() throws Exception {
+        byte[] bytes = new byte[1024 * 128];
+        new java.util.Random(1234).nextBytes(bytes);
+        var executor = Executors.newFixedThreadPool(4);
+        try {
+            Callable<Path> extract = () -> MacNativePlatform.extractLibrary(temporary, "3.0-dev", bytes);
+            var results = executor.invokeAll(List.of(extract, extract, extract, extract));
+            Path path = results.get(0).get();
+            for (var result : results) {
+                assertEquals(path, result.get());
+                assertArrayEquals(bytes, Files.readAllBytes(result.get()));
+            }
+            Files.write(path, new byte[]{0});
+            assertEquals(path, extract.call());
+            assertArrayEquals(bytes, Files.readAllBytes(path));
+            try (var files = Files.list(temporary)) {
+                assertEquals(1, files.count());
+            }
+        } finally {
+            executor.shutdownNow();
+        }
+    }
+}
