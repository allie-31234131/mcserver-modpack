@@ -29,9 +29,29 @@ class ModelDirectoryWatcherTest {
             var model = root.resolve("model.mxc").toAbsolutePath().normalize();
             Files.writeString(model, "changed");
 
-            var event = events.poll(5, TimeUnit.SECONDS);
-            assertNotNull(event);
-            assertTrue(event.overflow() || event.paths().contains(model));
+            var expected = model.toRealPath();
+            var deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+            SourceChangeSet event;
+            while ((event = events.poll(100, TimeUnit.MILLISECONDS)) != null
+                    || System.nanoTime() < deadline) {
+                if (event != null && (event.overflow() || event.paths().stream()
+                        .anyMatch(path -> sameFile(path, expected)))) {
+                    return;
+                }
+                if (System.nanoTime() >= deadline) break;
+            }
+            assertNotNull(event, "No matching filesystem event was emitted");
+            assertTrue(event.overflow() || event.paths().stream()
+                    .anyMatch(path -> sameFile(path, expected)),
+                    "Unexpected filesystem event paths: " + event.paths());
+        }
+    }
+
+    private static boolean sameFile(Path left, Path right) {
+        try {
+            return Files.exists(left) && Files.isSameFile(left, right);
+        } catch (Exception ignored) {
+            return left.toAbsolutePath().normalize().equals(right.toAbsolutePath().normalize());
         }
     }
 
