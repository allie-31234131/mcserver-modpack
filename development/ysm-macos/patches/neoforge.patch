diff --git a/src/test/java/com/elfmcys/ysm/port/NeoForgeMixinTargetsTest.java b/src/test/java/com/elfmcys/ysm/port/NeoForgeMixinTargetsTest.java
new file mode 100644
index 0000000..a73e63d
--- /dev/null
+++ b/src/test/java/com/elfmcys/ysm/port/NeoForgeMixinTargetsTest.java
@@ -0,0 +1,120 @@
+package com.elfmcys.ysm.port;
+
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Type;
+import org.objectweb.asm.tree.*;
+
+import java.io.InputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.*;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/** Checks pinned host bytecode, not a substitute for booting the Mixin transformer. */
+class NeoForgeMixinTargetsTest {
+    private static final String MIXIN = "Lorg/spongepowered/asm/mixin/";
+
+    @Test
+    void configuredTargetsExistOnNeoForge1211() throws Exception {
+        var config = JsonParser.parseString(Files.readString(Path.of("src/main/resources/ysm.mixins.json"))).getAsJsonObject();
+        var failures = new ArrayList<String>();
+        for (String section : List.of("mixins", "client")) {
+            for (var entry : config.getAsJsonArray(section)) {
+                String name = config.get("package").getAsString() + "." + entry.getAsString();
+                var mixin = read(name.replace('.', '/'));
+                var annotation = annotation(mixin.invisibleAnnotations, MIXIN + "Mixin;");
+                assertNotNull(annotation, name);
+                @SuppressWarnings("unchecked")
+                var targets = (List<Type>) value(annotation, "value");
+                for (Type target : targets) check(mixin, read(target.getInternalName()), failures);
+            }
+        }
+        assertTrue(failures.isEmpty(), String.join("\n", failures));
+    }
+
+    private static void check(ClassNode mixin, ClassNode target, List<String> failures) throws Exception {
+        for (var field : mixin.fields) {
+            if (annotation(field.visibleAnnotations, MIXIN + "Shadow;") != null || annotation(field.invisibleAnnotations, MIXIN + "Shadow;") != null) {
+                if (!hasField(target, field.name, field.desc)) failures.add(mixin.name + " shadow " + field.name + field.desc);
+            }
+        }
+        for (var method : mixin.methods) {
+            var annotations = new ArrayList<AnnotationNode>();
+            if (method.visibleAnnotations != null) annotations.addAll(method.visibleAnnotations);
+            if (method.invisibleAnnotations != null) annotations.addAll(method.invisibleAnnotations);
+            for (var ann : annotations) {
+                if (ann.desc.equals(MIXIN + "Shadow;") && !hasMethod(target, method.name, method.desc)) failures.add(mixin.name + " shadow " + method.name + method.desc);
+                if (ann.desc.equals(MIXIN + "gen/Accessor;")) {
+                    String name = (String) value(ann, "value");
+                    if (name == null || name.isEmpty()) name = inferName(method.name);
+                    Type returnType = Type.getReturnType(method.desc);
+                    String descriptor = returnType.equals(Type.VOID_TYPE) ? Type.getArgumentTypes(method.desc)[0].getDescriptor() : returnType.getDescriptor();
+                    if (!hasField(target, name, descriptor)) failures.add(mixin.name + " accessor " + name + descriptor);
+                }
+                if (ann.desc.equals(MIXIN + "gen/Invoker;")) {
+                    String name = (String) value(ann, "value");
+                    if (name == null || name.isEmpty()) name = inferName(method.name);
+                    if (!hasMethod(target, name, method.desc)) failures.add(mixin.name + " invoker " + name + method.desc);
+                }
+                Object selectors = value(ann, "method");
+                if (!(selectors instanceof List<?> list)) continue;
+                for (Object selector : list) {
+                    if (!(selector instanceof String text)) continue;
+                    int split = text.indexOf('(');
+                    String name = split < 0 ? text : text.substring(0, split);
+                    String descriptor = split < 0 ? null : text.substring(split);
+                    if (!hasMethod(target, name, descriptor)) failures.add(mixin.name + " inject " + text);
+                    for (String invocation : invocations(value(ann, "at"))) {
+                        boolean found = target.methods.stream().filter(m -> m.name.equals(name) && (descriptor == null || m.desc.equals(descriptor))).anyMatch(m -> {
+                            for (var insn : m.instructions) if (insn instanceof MethodInsnNode call && invocation.equals("L" + call.owner + ";" + call.name + call.desc)) return true;
+                            return false;
+                        });
+                        if (!found) failures.add(mixin.name + " invocation " + invocation + " in " + text);
+                    }
+                }
+            }
+        }
+    }
+
+    private static List<String> invocations(Object at) {
+        if (at instanceof AnnotationNode ann && "INVOKE".equals(value(ann, "value")) && value(ann, "target") instanceof String target) return List.of(target);
+        if (at instanceof List<?> list) return list.stream().flatMap(v -> invocations(v).stream()).toList();
+        return List.of();
+    }
+
+    private static String inferName(String method) {
+        String name = method.replaceFirst("^(get|set|is|invoke|call)", "");
+        return Character.toLowerCase(name.charAt(0)) + name.substring(1);
+    }
+
+    private static boolean hasField(ClassNode owner, String name, String desc) throws Exception {
+        if (owner.fields.stream().anyMatch(f -> f.name.equals(name) && f.desc.equals(desc))) return true;
+        return owner.superName != null && hasField(read(owner.superName), name, desc);
+    }
+
+    private static boolean hasMethod(ClassNode owner, String name, String desc) throws Exception {
+        if (owner.methods.stream().anyMatch(m -> m.name.equals(name) && (desc == null || m.desc.equals(desc)))) return true;
+        return owner.superName != null && hasMethod(read(owner.superName), name, desc);
+    }
+
+    private static ClassNode read(String name) throws Exception {
+        try (InputStream input = NeoForgeMixinTargetsTest.class.getClassLoader().getResourceAsStream(name + ".class")) {
+            assertNotNull(input, "Missing class: " + name);
+            var node = new ClassNode();
+            new ClassReader(input).accept(node, 0);
+            return node;
+        }
+    }
+
+    private static AnnotationNode annotation(List<AnnotationNode> annotations, String descriptor) {
+        return annotations == null ? null : annotations.stream().filter(a -> a.desc.equals(descriptor)).findFirst().orElse(null);
+    }
+
+    private static Object value(AnnotationNode ann, String key) {
+        if (ann.values != null) for (int i = 0; i < ann.values.size(); i += 2) if (key.equals(ann.values.get(i))) return ann.values.get(i + 1);
+        return null;
+    }
+}
