+            ProjectileModelInfoCapability::serializeNBT, ProjectileModelInfoCapability::deserializeNBT);
+    public static final Supplier<AttachmentType<VehicleModelInfoCapability>> VEHICLE = persistent(
+            "vehicle_model_id", VehicleModelInfoCapability::new,
+            VehicleModelInfoCapability::serializeNBT, VehicleModelInfoCapability::deserializeNBT);
+
+    private YsmAttachments() {
+    }
+
+    public static void register(IEventBus bus) {
+        if (FMLEnvironment.dist == Dist.CLIENT) {
+            ClientRegistration.initializeTypes();
+        }
+        TYPES.register(bus);
+    }
+
+    public static <T> Supplier<AttachmentType<T>> transientType(String name,
+                                                               Function<IAttachmentHolder, T> factory) {
+        return TYPES.register(name, () -> AttachmentType.builder(factory).build());
+    }
+
+    private static <S extends net.minecraft.nbt.Tag, T> Supplier<AttachmentType<T>> persistent(String name, Supplier<T> factory,
+                                                              Function<T, S> writer,
+                                                              BiConsumer<T, S> reader) {
+        return TYPES.register(name, () -> AttachmentType.builder(factory)
+                .serialize(new IAttachmentSerializer<S, T>() {
+                    @Override
+                    public T read(IAttachmentHolder holder, S tag, HolderLookup.Provider registries) {
+                        T value = factory.get();
+                        reader.accept(value, tag);
+                        return value;
+                    }
+
+                    @Override
+                    public S write(T value, HolderLookup.Provider registries) {
+                        return writer.apply(value);
+                    }
+                }).build());
+    }
+
+    /** Looking up an uninitialized animation must not create one for every ordinary entity. */
+    public static <T> Optional<T> find(Entity entity, Supplier<AttachmentType<T>> type) {
+        return entity.hasData(type) ? Optional.of(entity.getData(type)) : Optional.empty();
+    }
+
+    public static void initializeEntity(Entity entity) {
+        if (entity instanceof Player) {
+            entity.getData(AUTH);
+            entity.getData(STAR);
+            if (!entity.level().isClientSide()) {
+                entity.getData(MODEL);
+            }
+        } else if (!entity.level().isClientSide()) {
+            if (entity instanceof Projectile) {
+                entity.getData(PROJECTILE);
+            } else {
+                entity.getData(VEHICLE);
+            }
+        }
+        if (FMLEnvironment.dist == Dist.CLIENT && entity.level().isClientSide()) {
+            ClientRegistration.initializeEntity(entity);
+        }
+    }
+
+    private static final class ClientRegistration {
+        private static void initializeTypes() {
+            PlayerAnimatableCapabilityProvider.CAP.getClass();
+            ProjectileAnimatableCapabilityProvider.CAP.getClass();
+            VehicleAnimatableCapabilityProvider.CAP.getClass();
+            ClientLazyCapabilityProvider.CAP.getClass();
+            if (net.neoforged.fml.ModList.get().isLoaded("touhou_little_maid")) {
+                com.elfmcys.ysm.client.compat.touhoulittlemaid.capability.YsmMaidCapabilityProvider.CAP.getClass();
+            }
+        }
+
+        private static void initializeEntity(Entity entity) {
+            if (entity instanceof net.minecraft.client.player.AbstractClientPlayer) {
+                entity.getData(PlayerAnimatableCapabilityProvider.CAP);
+            } else {
+                entity.getData(ClientLazyCapabilityProvider.CAP);
+            }
+        }
+    }
+}
