+    @Nullable
+    private static PlatformConfig detectMacOSConfig(String modVersion) {
+        if (!MacNativePlatform.isArm64(SystemUtils.OS_ARCH)) {
+            setUnsupportedPlatformMsg("macOS requires an ARM64 JVM on Apple Silicon; Intel/Rosetta is unsupported");
+            return null;
+        }
+        if (!MacNativePlatform.meetsMinimumVersion(SystemUtils.OS_VERSION)) {
+            setUnsupportedPlatformMsg("macOS 14.5 or later is required");
+            return null;
+        }
+        return new PlatformConfig(MACOS_LIB_NAME,
+                "libysm-" + MacNativePlatform.safeVersion(modVersion) + ".dylib",
+                MacNativePlatform.libraryDirectory(System.getProperty("user.home")));
