@@ -0,0 +1,38 @@
+package com.elfmcys.ysm.util;
+
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class MacNativePlatformTest {
+    @Test
+    void acceptsBothJvmArm64NamesAndRejectsIntel() {
+        assertTrue(MacNativePlatform.isArm64("aarch64"));
+        assertTrue(MacNativePlatform.isArm64("arm64"));
+        assertTrue(MacNativePlatform.isArm64("ARM64"));
+        assertFalse(MacNativePlatform.isArm64("x86_64"));
+        assertFalse(MacNativePlatform.isArm64("amd64"));
+        assertFalse(MacNativePlatform.isArm64(null));
+    }
+
+    @Test
+    void enforcesTheNativeDeploymentTarget() {
+        for (String version : new String[]{"14.5", "14.5.0", "14.6.1", "15.0", "26.6.2"}) {
+            assertTrue(MacNativePlatform.meetsMinimumVersion(version), version);
+        }
+        for (String version : new String[]{"13.7.1", "14", "14.4.9", "", "unknown"}) {
+            assertFalse(MacNativePlatform.meetsMinimumVersion(version), version);
+        }
+        assertFalse(MacNativePlatform.meetsMinimumVersion(null));
+    }
+
+    @Test
+    void preservesSpacesInTheUserLibraryPath() {
+        assertEquals(Path.of("/Users/Test User/Library/Application Support/ysm/native/macos-arm64"),
+                MacNativePlatform.libraryDirectory("/Users/Test User"));
+        assertEquals("3.0-dev-forge+mc1.20.1_unsafe_name",
+                MacNativePlatform.safeVersion("3.0-dev-forge+mc1.20.1/unsafe\\name"));
+    }
+}
