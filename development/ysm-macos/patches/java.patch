+/** macOS native prerequisites, independent of Minecraft initialization. */
+final class MacNativePlatform {
+    private MacNativePlatform() {
+    }
+
+    static boolean isArm64(String architecture) {
+        return "aarch64".equalsIgnoreCase(architecture) || "arm64".equalsIgnoreCase(architecture);
+    }
+
+    static boolean meetsMinimumVersion(String version) {
+        if (version == null) {
+            return false;
+        }
+        var parts = version.split("\\.");
+        try {
+            int major = Integer.parseInt(parts[0]);
+            int minor = parts.length > 1 ? Integer.parseInt(parts[1]) : 0;
+            return major > 14 || major == 14 && minor >= 5;
+        } catch (NumberFormatException ignored) {
+            return false;
+        }
+    }
+
+    static Path libraryDirectory(String home) {
+        return Path.of(home, "Library", "Application Support", "ysm", "native", "macos-arm64");
+    }
+
+    static String safeVersion(String version) {
+        return version.toLowerCase(Locale.ROOT).replaceAll("[^a-z0-9._+-]", "_");
+    }
+
+    /** Content-addressed names keep updates separate from dylibs mapped by another game process. */
+    static Path extractLibrary(Path directory, String version, byte[] data) throws IOException {
+        final String digest;
+        try {
+            digest = HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(data));
+        } catch (NoSuchAlgorithmException impossible) {
+            throw new AssertionError(impossible);
+        }
+        Files.createDirectories(directory);
+        Path target = directory.resolve("libysm-" + safeVersion(version) + "-" + digest + ".dylib");
+        if (Files.isRegularFile(target) && java.util.Arrays.equals(Files.readAllBytes(target), data)) {
+            return target;
+        }
+        Path temporary = Files.createTempFile(directory, ".ysm-", ".dylib");
+        try {
+            Files.write(temporary, data);
+            try {
+                Files.move(temporary, target, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+            } catch (AtomicMoveNotSupportedException unsupported) {
+                // Both paths are in the same directory. A filesystem without atomic rename cannot
+                // safely publish a library which another game process may immediately load.
+                throw new IOException("The YSM native cache must support atomic file replacement", unsupported);
+            } catch (IOException concurrentPublication) {
+                // Windows test hosts may deny replacing a target which another reader has open.
+                // Accept only an independently published, complete, byte-identical artifact.
+                if (!Files.isRegularFile(target) || !java.util.Arrays.equals(Files.readAllBytes(target), data)) {
+                    throw concurrentPublication;
+                }
+            }
+            return target;
+        } finally {
+            Files.deleteIfExists(temporary);
+        }
+    }
+}
